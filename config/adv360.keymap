#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
        };

        hmleft: hmleft {
            compatible = "zmk,behavior-hold-tap";
            label = "HMLEFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
        };

        hmright: hmright {
            compatible = "zmk,behavior-hold-tap";
            label = "HMRIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
        };
    };

    combos {
        compatible = "zmk,combos";

        comboesc2 {
            bindings = <&kp ESCAPE>;
            key-positions = <32 31>;
        };

        comboesc {
            bindings = <&kp ESCAPE>;
            key-positions = <41 42>;
        };

        combokptoggle {
            bindings = <&tog 1>;
            key-positions = <66 69>;
        };

        combocapsword {
            bindings = <&caps_word>;
            key-positions = <46 59>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <69 70>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&hm LS(LA(LG(LCTRL))) ESCAPE  &kp N1            &kp N2  &kp N3  &kp N4              &kp N5          &kp LC(F11)                                                         &kp LC(F14)    &kp N6           &kp N7               &kp N8     &kp N9   &kp N0                     &hm RS(RA(RCTRL)) DEL
&caps_word                    &kp Q             &kp W   &kp E   &hm LEFT_CONTROL R  &hm LEFT_ALT T  &kp LC(F12)                                                         &kp F15        &hm RIGHT_ALT Y  &hm RIGHT_CONTROL U  &kp I      &kp O    &kp P                      &kp RC(C)
&kp APOSTROPHE                &hm LEFT_SHIFT A  &kp S   &kp D   &kp F               &kp G           &kp LC(F13)  &kp ESC    &mt RALT PSCRN      &kp HOME   &kp END      &kp F16        &kp H            &kp J                &kp K      &kp L    &hm RIGHT_SHIFT SEMICOLON  &kp DOUBLE_QUOTES
&kp F18                       &kp Z             &kp X   &kp C   &kp V               &hm LEFT_GUI B                          &kp LC(A)           &kp PG_UP                              &hm RIGHT_GUI N  &kp M                &kp COMMA  &kp DOT  &kp SLASH                  &kp LC(V)
&kp F1                        &kp F2            &kp F3  &kp F4  &kp F5                              &kp SPACE    &lt 1 TAB  &kp DEL             &kp PG_DN  &lt 1 ENTER  &kp BACKSPACE                   &kp F6               &kp F7     &kp F8   &lt 2 F9                   &lt 3 F10
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &kp EXCLAMATION      &kp AT         &kp HASH     &kp DOLLAR      &kp PERCENT        &trans                                      &trans  &kp CARET         &kp AMPERSAND      &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS  &trans
&trans  &kp GRAVE            &kp BSLH       &kp PLUS     &kp MINUS       &kp SQT            &trans                                      &trans  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp F17                &trans
&trans  &hm LEFT_SHIFT HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END         &kp DEL            &trans  &trans  &trans      &trans  &trans  &trans  &kp LEFT          &kp DOWN           &kp UP                &kp RIGHT              &hm RIGHT_SHIFT COLON  &trans
&trans  &kp TILDE            &kp PIPE       &kp EQUAL    &kp UNDERSCORE  &kp DOUBLE_QUOTES                  &trans      &trans                  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN         &kp GREATER_THAN       &kp QUESTION           &trans
&trans  &trans               &trans         &trans       &trans                             &trans  &trans  &trans      &trans  &trans  &trans                    &trans             &trans                &trans                 &trans                 &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none                                             &none         &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans   &trans  &trans  &trans  &trans  &trans  &kp C_BRI_UP                                      &kp C_VOL_UP  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &kp C_BRI_DN  &trans  &trans      &trans  &trans  &kp C_VOL_DN  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans                        &trans      &trans                        &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans          &trans        &trans  &trans      &trans  &trans  &trans                &trans  &trans  &trans  &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
