#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combotab {
            bindings = <&kp ESCAPE>;
            key-positions = <32 31>;
        };

        comboesc {
            bindings = <&kp ESCAPE>;
            key-positions = <41 42>;
        };

        combokptoggle {
            bindings = <&tog 1>;
            key-positions = <66 69>;
        };

        combocapsword {
            bindings = <&caps_word>;
            key-positions = <46 59>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <40 41>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <43 44>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <69 70>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL   &kp N1            &kp N2  &kp N3  &kp N4                    &kp N5          &kp F12                                                           &kp F13         &kp N6           &kp N7                     &kp N8     &kp N9   &kp N0                     &kp MINUS
&kp GRAVE   &kp Q             &kp W   &kp E   &hm LEFT_CONTROL R        &hm LEFT_ALT T  &kp LC(C)                                                         &msc SCRL_UP    &hm RIGHT_ALT Y  &hm RIGHT_CONTROL U        &kp I      &kp O    &kp P                      &kp BSLH
&kp ESCAPE  &hm LEFT_SHIFT A  &kp S   &kp D   &kp F                     &kp G           &kp LC(V)  &kp ESC    &mt RALT PSCRN      &kp HOME   &kp END      &msc SCRL_DOWN  &kp H            &kp J                      &kp K      &kp L    &hm RIGHT_SHIFT SEMICOLON  &kp SQT
&sk LSHFT   &kp Z             &kp X   &kp C   &hm LA(LC(LEFT_SHIFT)) V  &hm LEFT_GUI B                        &kp LC(A)           &kp PG_UP                               &hm RIGHT_GUI N  &hm RA(RC(RIGHT_SHIFT)) M  &kp COMMA  &kp DOT  &kp SLASH                  &sk RSHFT
&lt 3 F1    &kp F2            &kp F3  &kp F4  &kp F5                                    &kp SPACE  &lt 1 TAB  &kp DEL             &kp PG_DN  &lt 1 ENTER  &kp BACKSPACE                    &kp F6                     &kp F7     &kp F8   &lt 2 F9                   &lt 3 F10
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp PLUS   &kp EXCLAMATION  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &trans                                         &trans  &kp CARET         &kp AMPERSAND      &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS  &kp UNDERSCORE
&kp TILDE  &trans           &kp N7  &kp N8    &kp N9      &kp N0       &kp PLUS                                       &trans  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans                 &kp PIPE
&trans     &kp CARET        &kp N4  &kp N5    &kp N6      &kp DOT      &kp MINUS  &trans  &trans      &trans  &trans  &trans  &kp LEFT          &kp DOWN           &kp UP                &kp RIGHT              &kp COLON              &kp DOUBLE_QUOTES
&trans     &trans           &kp N1  &kp N2    &kp N3      &kp BSPC                        &trans      &trans                  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN         &kp GREATER_THAN       &kp QUESTION           &trans
&trans     &trans           &trans  &trans    &trans                   &trans     &trans  &trans      &trans  &trans  &trans                    &trans             &trans                &trans                 &trans                 &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &none                                             &none         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_BRI_UP                                      &kp C_VOL_UP  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_BRI_DN  &trans  &trans      &trans  &trans  &kp C_VOL_DN  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                        &trans      &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans        &trans  &trans      &trans  &trans  &trans                &trans  &trans  &trans  &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
